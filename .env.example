# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The app and every script (including the audit retention CLI) read this.
MONGODB_URI=<mongodb+srv://...>

# ---------------------------------------------------------------------------
# Session signing
# ---------------------------------------------------------------------------
# Signs the `auth_token` session cookie. Anyone who knows this value can mint a
# token with any role, including Admin, and read vaulted PII. Required, and it
# must be at least 32 characters of real random data: the app refuses to start
# in production if this is missing, too short, or a known placeholder.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing it logs everybody out.
JWT_SECRET=<48+ random bytes, base64url or hex>

# ---------------------------------------------------------------------------
# Quick Sign In (development convenience) — not for production
# ---------------------------------------------------------------------------
# The landing page's Quick Sign In buttons need the seeded accounts' usernames
# and passwords. Those values are NOT read by the client: they are served from
# GET /api/auth/demo-accounts, which returns 404 when NODE_ENV=production.
#
# Never rename these to NEXT_PUBLIC_*. A NEXT_PUBLIC_ prefix inlines the value
# into the browser bundle at build time, which is how these passwords previously
# leaked to anyone who downloaded the JavaScript.
NEXT_PUBLIC_SHOW_QUICK_SIGNIN=true
NEXT_PUBLIC_DEFAULT_PASSWORD=gems1234
NEXT_PUBLIC_ADMIN_PASSWORD=Admin123!
NEXT_PUBLIC_FOCAL_PASSWORD=focal123!
NEXT_PUBLIC_ADMIN_USERNAME=Admin
NEXT_PUBLIC_FOCAL_USERNAME=Focal
NEXT_PUBLIC_COORDINATOR_USERNAME=DeLuna-MalinaoEunice
NEXT_PUBLIC_DEAN_USERNAME=MalinaoRonjieMar
NEXT_PUBLIC_PLANNINGDIRECTOR_USERNAME=JardinianoMarkLouisse
NEXT_PUBLIC_PRESIDENT_USERNAME=ZuluetaDiosdado
NEXT_PUBLIC_ICTUDIRECTOR_USERNAME=JusonJoy
NEXT_PUBLIC_STUDENT_USERNAME=24b0128

# ---------------------------------------------------------------------------
# Identity Vault (PII split) — required in production
# ---------------------------------------------------------------------------
# AES-256-GCM key protecting the IdentityVault collection. 32 bytes, written
# as 64 hex characters. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: losing this key means the vaulted PII (names, birthdays, contact
# details) can never be decrypted again. Keep two sealed offline copies and
# back them up separately from the database.
PII_ENCRYPTION_KEY=<64 hex characters>

# Bump alongside a key rotation. Rows keep the version they were written with,
# so a mixed-version vault stays readable.
PII_ENCRYPTION_KEY_VERSION=1

# During a rotation, set this to the retiring key so old rows still decrypt.
# Remove it once scripts/rotate-pii-key.mjs has re-encrypted everything.
# PII_ENCRYPTION_KEY_PREVIOUS=<previous 64 hex characters>

# Optional: prefix for public display IDs (defaults to GEMS -> GEMS-A3F9C2).
# GEMS_ID_PREFIX=GEMS

# Optional: set to "true" to let Admin / GAD Focal view full PII in this
# environment. Leave unset in production so masking is the default everywhere.
# PII_REVEAL_FULL=true

# ---------------------------------------------------------------------------
# Audit trail retention & archival
# ---------------------------------------------------------------------------
# Retention is applied only by an operator running
#   npm run audit:retention           # report only, changes nothing
#   npm run audit:retention -- --apply  # archive, record, then dispose
#
# It is deliberately NOT scheduled. A job that deletes audit records means
# whoever can edit the schedule can shorten the trail quietly, and the job keeps
# running after the person who approved it has gone. tests/auditRetentionScheduling
# .test.mjs fails if a scheduler is added without that argument being made.

# How long security-relevant records are kept (logins, role changes, deletions,
# anything in LONG_RETENTION_ACTIONS). Defaults to 2555 days (7 years).
#
# Seven years is PROVISIONAL, not a legal determination — see the comment in
# lib/auditRetention.js. Replace it once the DPO or records officer rules on the
# actual obligation, and record who decided and why.
# AUDIT_RETENTION_DAYS_SECURITY=2555

# How long routine activity is kept. Defaults to the security period above,
# i.e. everything is kept for the long band unless you deliberately separate
# them. Setting this shorter is a real decision: those records stop being
# evidence sooner.
# AUDIT_RETENTION_DAYS_ACTIVITY=730

# Key prefix for archived records in the bucket. Archives are NDJSON, one record
# per line, named <prefix>/<timestamp>-<count>.jsonl so they sort
# chronologically.
# AUDIT_ARCHIVE_PREFIX=audit-archive

# Archive destination. BOTH must be set or disposal refuses to run: the archive
# is the only remaining copy once records are deleted, so there is no "delete
# anyway" path.
#
# Use a bucket with object-lock or versioning if the archive has to be
# tamper-evident — S3 deletes by anyone holding the credentials are otherwise a
# way to remove evidence that the app's own chain verification can no longer see.
# AWS_REGION=ap-southeast-1
# AWS_BUCKET_NAME=<audit archive bucket>
# AWS_ACCESS_KEY_ID=<...>
# AWS_SECRET_ACCESS_KEY=<...>
