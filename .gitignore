# Ignore scripts and data
app/scripts/
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
app/data/

# Generated PDF previews (safe to delete, like gpb-progress-preview-*.pdf)
*-preview.pdf

# One-off script backups (may contain personal data)
scripts/backups/

# One-off OCR / import scratch (may contain personal data + generates 50+ images)
scripts/_gad2023-src/
scripts/*preview.html
scripts/*-import.json
scripts/_*.mjs

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
